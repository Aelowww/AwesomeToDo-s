MONGODB_URI=your_mongodb_connection_string
PORT=5000
JWT_SECRET=any_long_random_string
# Optional: turns on Study Buddy (AI). Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Or use Claude instead: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: send "forgot password" emails. For Gmail use smtp.gmail.com, port 465 and an App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Public address of the app, used in reset links (e.g. https://awesometodos-web.onrender.com)
APP_URL=
